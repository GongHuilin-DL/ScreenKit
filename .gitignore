# =========================================
# Python
# =========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# =========================================
# IDE / 编辑器
# =========================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# =========================================
# 项目运行生成产物
# =========================================
# 用户生成的图片/视频
output/
# 录制/拼接过程中的临时文件
temp/
# 运行日志
logs/
# 用户个性化配置与历史记录
config/user.yaml
config/history.json

# =========================================
# PyInstaller 打包产物
# =========================================
build/
dist/
*.manifest
*.spec.bak
# 注意：ScreenKit.spec 是打包配置，必须保留上传

# =========================================
# 大文件 / 外部依赖
# =========================================
# 不要将 ffmpeg 二进制文件提交到仓库（几十 MB）
tools/ffmpeg/*.exe
tools/ffmpeg/*.dll